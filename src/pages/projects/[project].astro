---
import PostCards from '../../components/PostCards.astro';
import SubNav from '../../components/SubNav.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, getProjects, postCount } from '../../lib/posts';
import { transitionName } from '../../lib/transitions';

export async function getStaticPaths() {
	const posts = await getPosts();
	return getProjects(posts).map(({ name }) => ({
		params: { project: name },
		props: { posts: posts.filter((post) => post.data.project === name) },
	}));
}

const { project } = Astro.params;
const { posts } = Astro.props;
---

<Base title={project} description={`Experiment notes from the ${project} project.`}>
	<SubNav name={project}>
		<a href="/projects/">All projects</a>
	</SubNav>

	<section class="tile tile--center">
		<div class="container">
			<h1 class="hero-display" style={transitionName('project', project)}>{project}</h1>
			<p class="lead">{postCount(posts.length)}</p>
		</div>
	</section>

	<section class="tile tile--parchment">
		<div class="container">
			<PostCards posts={posts} showProject={false} />
		</div>
	</section>
</Base>
