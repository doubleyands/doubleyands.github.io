---
import Base from '../../layouts/Base.astro';
import { getPosts, getProjects, isoDate, postCount } from '../../lib/posts';
import { transitionName } from '../../lib/transitions';

const projects = getProjects(await getPosts());
---

<Base title="Projects" description="Experiment notes grouped by project.">
	<section class="tile tile--center">
		<div class="container">
			<h1 class="hero-display">Projects</h1>
			<p class="lead">Experiment notes grouped by project.</p>
		</div>
	</section>

	<section class="tile tile--parchment">
		<div class="container">
			{
				projects.length === 0 ? (
					<div class="empty">
						<h2 class="tagline">No public projects yet.</h2>
					</div>
				) : (
					<ul class="card-grid">
						{projects.map((project) => (
							<li class="reveal">
								<a class="card" href={`/projects/${project.name}/`}>
									<h2 class="tagline" style={transitionName('project', project.name)}>
										{project.name}
									</h2>
									<p class="description">{postCount(project.count)}</p>
									<p class="foot caption">
										<time datetime={isoDate(project.latest)}>Latest {isoDate(project.latest)}</time>
										<span class="more">View &rsaquo;</span>
									</p>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>
</Base>
