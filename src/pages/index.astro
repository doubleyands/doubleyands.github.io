---
import FlowHero from '../components/FlowHero.astro';
import PostCards from '../components/PostCards.astro';
import Base from '../layouts/Base.astro';
import { getPosts, getProjects, isCourseNote, postCount } from '../lib/posts';
import { transitionName } from '../lib/transitions';

// Research comes first. Course notes get a short row, and the rest is one click away.
const RESEARCH_LIMIT = 6;
const COURSE_LIMIT = 3;

const posts = await getPosts();
const projects = getProjects(posts);
const research = posts.filter((post) => !isCourseNote(post));
const courseNotes = posts.filter(isCourseNote);
const courses = getProjects(courseNotes);
---

<Base>
	<FlowHero />

	{
		posts.length === 0 && (
			<section class="tile tile--parchment">
				<div class="container">
					<div class="empty">
						<h2 class="tagline">No posts yet.</h2>
						<p>Experiment notes will appear here.</p>
					</div>
				</div>
			</section>
		)
	}

	{
		research.length > 0 && (
			<section class="tile tile--parchment">
				<div class="container">
					<div class="tile-head reveal">
						<h2 class="display-lg">Research</h2>
						<p class="lead">Experiments with neural networks that solve PDEs.</p>
					</div>
					<PostCards posts={research.slice(0, RESEARCH_LIMIT)} />
				</div>
			</section>
		)
	}

	{
		courseNotes.length > 0 && (
			<section class="tile">
				<div class="container">
					<div class="tile-head reveal">
						<h2 class="display-lg">Course notes</h2>
						<p class="lead">My notes on numerical methods, one lecture at a time.</p>
					</div>
					<PostCards posts={courseNotes.slice(0, COURSE_LIMIT)} />
					<div class="cta-row reveal">
						{courses.map((course) => (
							<a class="pill pill--ghost" href={`/projects/${course.name}/`}>
								All {course.name} notes ({course.count})
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		projects.length > 0 && (
			<section class="tile tile--dark tile--center">
				<div class="container">
					<div class="tile-head reveal">
						<h2 class="display-lg">Projects</h2>
						<p class="lead">Browse posts by project.</p>
					</div>
					<ul class="chip-row">
						{projects.map((project) => (
							<li class="reveal">
								<a class="chip" href={`/projects/${project.name}/`}>
									<span class="caption-strong" style={transitionName('project', project.name)}>
										{project.name}
									</span>
									<span class="count caption">{postCount(project.count)}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}
</Base>
