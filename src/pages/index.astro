---
import PostCards from '../components/PostCards.astro';
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';
import { getPosts, getProjects, postCount } from '../lib/posts';

const posts = await getPosts();
const projects = getProjects(posts);
---

<Base>
	<section class="tile tile--center">
		<div class="container">
			<h1 class="hero-display">{profile.name}</h1>
			<p class="lead">{profile.role}</p>
			<p class="interests caption">
				{profile.interests.map((interest) => interest.name).join(' · ')}
			</p>
			<div class="cta-row">
				<a class="pill" href="/about/">About me</a>
				<a class="pill pill--ghost" href="/projects/">Projects</a>
			</div>
		</div>
	</section>

	<section class="tile tile--parchment">
		<div class="container">
			{
				posts.length === 0 ? (
					<div class="empty">
						<h2 class="tagline">No posts yet.</h2>
						<p>Experiment notes will appear here.</p>
					</div>
				) : (
					<>
						<div class="tile-head">
							<h2 class="display-lg">Latest posts</h2>
						</div>
						<PostCards posts={posts} />
					</>
				)
			}
		</div>
	</section>

	{
		projects.length > 0 && (
			<section class="tile tile--dark tile--center">
				<div class="container">
					<div class="tile-head">
						<h2 class="display-lg">Projects</h2>
						<p class="lead">Browse posts by project.</p>
					</div>
					<ul class="chip-row">
						{projects.map((project) => (
							<li>
								<a class="chip" href={`/projects/${project.name}/`}>
									<span class="caption-strong">{project.name}</span>
									<span class="count caption">{postCount(project.count)}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}
</Base>
