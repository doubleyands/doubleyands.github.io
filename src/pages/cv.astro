---
import CvEntries from '../components/CvEntries.astro';
import { cv, ME } from '../data/cv';
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';

const isMe = (author: string) => author.replace('*', '') === ME;
---

<Base title="CV" description={`CV of ${profile.name}. ${cv.headline}.`}>
	<section class="tile tile--center cv-head">
		<div class="container">
			<p class="eyebrow caption-strong">Curriculum Vitae</p>
			<h1 class="hero-display">{profile.name}</h1>
			<p class="lead">{cv.headline}</p>
			<p class="cv-contact">
				{cv.email && <a href={`mailto:${cv.email}`}>{cv.email}</a>}
				{
					cv.links.map((link) => (
						<a href={link.url} data-print={link.url.replace(/^https:\/\//, '')}>
							{link.label}
						</a>
					))
				}
			</p>
			<div class="cta-row cv-actions">
				<button type="button" class="pill pill--ghost" id="cv-print">Save as PDF</button>
			</div>
		</div>
	</section>

	<section class="tile cv-body">
		<div class="container">
			<div class="cv-row">
				<h2 class="tagline">Research interests</h2>
				<p class="cv-text">{cv.interests.join(' · ')}</p>
			</div>

			<div class="cv-row">
				<h2 class="tagline">Education</h2>
				<CvEntries entries={cv.education} />
			</div>

			<div class="cv-row">
				<h2 class="tagline">Research experience</h2>
				<CvEntries entries={cv.research} />
			</div>

			<div class="cv-row">
				<h2 class="tagline">Publications</h2>
				<div>
					{
						cv.publications.map((group) => (
							<div class="cv-pub-group">
								<h3 class="cv-period caption-strong">{group.heading}</h3>
								<ol class="cv-pubs">
									{group.items.map((publication) => (
										<li>
											<p class="cv-title">
												{publication.url ? (
													<a href={publication.url}>{publication.title}</a>
												) : (
													publication.title
												)}
											</p>
											<p class="cv-place">
												{publication.authors.map((author, i) => (
													<>
														{i > 0 && ', '}
														{isMe(author) ? <strong>{author}</strong> : author}
													</>
												))}
											</p>
											<p class="cv-venue">{publication.venue}</p>
										</li>
									))}
								</ol>
							</div>
						))
					}
					<p class="cv-note caption">* Corresponding author.</p>
				</div>
			</div>

			<div class="cv-row">
				<h2 class="tagline">Projects</h2>
				<CvEntries entries={cv.projects} />
			</div>

			<div class="cv-row">
				<h2 class="tagline">Awards</h2>
				<CvEntries entries={cv.awards} />
			</div>

			<div class="cv-row">
				<h2 class="tagline">Skills</h2>
				<dl class="cv-skills">
					{
						cv.skills.map((skill) => (
							<>
								<dt>{skill.label}</dt>
								<dd>{skill.value}</dd>
							</>
						))
					}
				</dl>
			</div>

			<div class="cv-row">
				<h2 class="tagline">Military service</h2>
				<CvEntries entries={cv.military} />
			</div>

			<p class="cv-updated caption">Updated {cv.updated}.</p>
		</div>
	</section>
</Base>

<script>
	document.getElementById('cv-print')?.addEventListener('click', () => window.print());
</script>
