#!/bin/sh
# 블로그에는 ME에서 공개를 허락한 프로젝트의 글만 올릴 수 있다.
# 허락 여부: $ME_DIR/projects/<프로젝트>/README.md 머리말의 `blog: true`
# 확인할 수 없으면 커밋을 막는다.

ME_DIR="${ME_DIR:-$HOME/Desktop/ME}"

# 파일의 첫 머리말(--- 사이)에서 key 의 값을 꺼낸다
front_matter_value() {
  tr -d '\r' | awk -v key="$1" '
    /^---[ \t]*$/ { n++; if (n == 2) exit; next }
    n == 1 && index($0, key ":") == 1 {
      v = substr($0, length(key) + 2)
      gsub(/^[ \t"\047]+|[ \t"\047]+$/, "", v)
      print v
      exit
    }'
}

project_allowed() {
  case "$1" in
    ""|*[!A-Za-z0-9._-]*|.|..) return 1 ;;
  esac
  readme="$ME_DIR/projects/$1/README.md"
  [ -f "$readme" ] || return 1
  [ "$(front_matter_value blog < "$readme")" = "true" ]
}

errors=$(
  git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do
    case "$f" in
      src/content/blog/.gitkeep|src/assets/posts/.gitkeep) ;;
      src/content/blog/*)
        project=$(git show ":$f" | front_matter_value project)
        if [ -z "$project" ]; then
          echo "  $f: 머리말에 project 가 없다"
        elif ! project_allowed "$project"; then
          echo "  $f: 프로젝트 '$project' 는 공개가 허락되지 않았다"
        fi
        ;;
      src/assets/posts/*)
        project=$(echo "$f" | cut -d/ -f4)
        if ! project_allowed "$project"; then
          echo "  $f: 프로젝트 '$project' 는 공개가 허락되지 않았다"
        fi
        ;;
    esac
  done
)

if [ -n "$errors" ]; then
  echo "커밋 거부: 공개가 허락되지 않은 내용이 있다 (ME 위치: $ME_DIR)"
  echo "$errors"
  exit 1
fi
